rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Role and status live in users/{uid}. Users cannot change their own role or status
    // (see the users rules below), so the document can be trusted.
    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isActive() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && me().status == 'active'; }
    function role() { return me().role; }
    function isAdmin() { return isActive() && role() == 'admin'; }
    function isInstructor() { return isActive() && role() == 'instructor'; }
    function isStudent() { return isActive() && role() == 'student'; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }

    match /users/{uid} {
      // Everyone may read their own profile (so a deactivated user gets a clear message); Admins read all.
      allow read: if isSelf(uid) || isAdmin();

      // Only Admins create accounts, and only student or instructor ones.
      allow create: if isAdmin()
        && request.resource.data.uid == uid
        && request.resource.data.role in ['student', 'instructor']
        && request.resource.data.status == 'active'
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'status',
             'idNumber', 'phone', 'createdBy', 'createdAt', 'preferences']);

      // Admins edit non-admin accounts (name, phone, ID, role, status). Admin accounts are never editable here.
      allow update: if (isAdmin()
          && resource.data.role != 'admin'
          && request.resource.data.role in ['student', 'instructor']
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['displayName', 'phone', 'idNumber', 'role', 'status']))
        // A user edits only their phone and preferences. Names are copied into schedules, attendance and grades,
        // so they change through the Admin; an Admin may edit their own name.
        || (isActive() && isSelf(uid)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(role() == 'admin' ? ['displayName', 'phone', 'preferences'] : ['phone', 'preferences']));

      allow delete: if false;
    }

    // School knowledge for the chatbot. Admins manage all entries; everyone else reads only PUBLISHED ones.
    match /schoolKnowledge/{docId} {
      allow read: if isAdmin() || (isActive() && resource.data.status == 'published');
      allow create, update: if isAdmin()
        && request.resource.data.category in ['history', 'background', 'mission-vision', 'core-values', 'programs', 'admissions', 'contact', 'community', 'administration']
        && request.resource.data.status in ['draft', 'published']
        && request.resource.data.title is string && request.resource.data.title.size() <= 120
        && request.resource.data.content is string && request.resource.data.content.size() <= 8000;
      allow delete: if isAdmin();
    }

    // Subjects: any active user reads; only Admins write. Subjects are archived, never deleted.
    match /subjects/{subjectId} {
      allow read: if isActive();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // Schedules: Admins manage everything. An Instructor reads classes they teach and a Student reads
    // classes they are enrolled in (enrolled uids are kept in studentIds).
    match /schedules/{scheduleId} {
      allow read: if isAdmin()
        || (isActive() && (resource.data.instructorId == request.auth.uid
                           || request.auth.uid in resource.data.studentIds));
      allow create, update, delete: if isAdmin();
    }

    // Attendance. One session per class per date (id = scheduleId_date). Instructors only create and edit
    // sessions for classes they teach; Admins read everything; Students read only their own records.
    function sessionDoc(sessionId) { return get(/databases/$(database)/documents/attendanceSessions/$(sessionId)).data; }
    function teaches(scheduleId) { return get(/databases/$(database)/documents/schedules/$(scheduleId)).data.instructorId == request.auth.uid; }

    match /attendanceSessions/{sessionId} {
      // `resource == null` lets an instructor check whether a session exists yet.
      allow read: if isAdmin() || (isInstructor() && (resource == null || resource.data.instructorId == request.auth.uid));
      allow create: if isInstructor()
        && request.resource.data.instructorId == request.auth.uid
        && sessionId == request.resource.data.scheduleId + '_' + request.resource.data.date
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && teaches(request.resource.data.scheduleId);
      allow update: if isInstructor()
        && resource.data.instructorId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['note', 'counts', 'updatedAt']);
      allow delete: if false;

      match /records/{studentId} {
        allow read: if isAdmin() || (isInstructor() && sessionDoc(sessionId).instructorId == request.auth.uid);
        allow create, update: if isInstructor()
          && sessionDoc(sessionId).instructorId == request.auth.uid
          && request.resource.data.studentId == studentId
          && request.resource.data.instructorId == request.auth.uid
          && request.resource.data.status in ['present', 'absent', 'late', 'excused'];
        allow delete: if false;
      }
    }

    // Collection-group reads of records (reports and the student's own history).
    match /{path=**}/records/{recordId} {
      allow read: if isAdmin()
        || (isActive() && (resource.data.studentId == request.auth.uid || resource.data.instructorId == request.auth.uid));
    }

    // Grading. The policy lives in settings/grading (Admin writes, everyone signed in reads).
    // Instructors write grades only for classes they teach and only for students enrolled in them.
    function gradingCfg() { return get(/databases/$(database)/documents/settings/grading).data; }
    function sched(scheduleId) { return get(/databases/$(database)/documents/schedules/$(scheduleId)).data; }

    match /settings/grading {
      allow read: if isActive();
      allow write: if isAdmin()
        && request.resource.data.periods is list && request.resource.data.periods.size() >= 1
        && request.resource.data.categories is list && request.resource.data.categories.size() >= 1
        && request.resource.data.scale.min is number && request.resource.data.scale.max is number
        && request.resource.data.scale.passingMark is number
        && request.resource.data.scale.max > request.resource.data.scale.min;
    }

    match /gradebooks/{gradebookId} {
      allow read: if isAdmin() || (isInstructor() && (resource == null || resource.data.instructorId == request.auth.uid));
      allow create, update: if isInstructor()
        && request.resource.data.instructorId == request.auth.uid
        && gradebookId == request.resource.data.scheduleId + '_' + request.resource.data.periodId
        && sched(request.resource.data.scheduleId).instructorId == request.auth.uid
        && request.resource.data.method in ['computed', 'manual'];
      allow delete: if false;
    }

    match /assessments/{assessmentId} {
      allow read: if isAdmin() || (isInstructor() && resource.data.instructorId == request.auth.uid);
      allow create: if isInstructor()
        && request.resource.data.instructorId == request.auth.uid
        && sched(request.resource.data.scheduleId).instructorId == request.auth.uid
        && request.resource.data.maxScore is number && request.resource.data.maxScore > 0;
      allow update: if isInstructor()
        && resource.data.instructorId == request.auth.uid
        && request.resource.data.scheduleId == resource.data.scheduleId
        && request.resource.data.periodId == resource.data.periodId
        && request.resource.data.maxScore is number && request.resource.data.maxScore > 0;
      allow delete: if isInstructor() && resource.data.instructorId == request.auth.uid;
    }

    match /grades/{gradeId} {
      allow read: if isAdmin()
        || (isActive() && (resource.data.studentId == request.auth.uid || resource.data.instructorId == request.auth.uid));
      allow create, update: if isInstructor()
        && request.resource.data.instructorId == request.auth.uid
        && gradeId == request.resource.data.scheduleId + '_' + request.resource.data.periodId + '_' + request.resource.data.studentId
        && sched(request.resource.data.scheduleId).instructorId == request.auth.uid
        && request.resource.data.studentId in sched(request.resource.data.scheduleId).studentIds
        && request.resource.data.method in ['computed', 'manual']
        && (request.resource.data.manualFinal == null
            || (request.resource.data.manualFinal.value is number
                && request.resource.data.manualFinal.value >= gradingCfg().scale.min
                && request.resource.data.manualFinal.value <= gradingCfg().scale.max));
      allow delete: if false;
    }

    // Notifications (in-app reminders). A person can only create and read their own; the id must start with their uid
    // and is unique per class occurrence, so a duplicate create is refused.
    match /notifications/{notificationId} {
      allow read: if isActive() && resource.data.userId == request.auth.uid;
      allow create: if isActive()
        && request.resource.data.userId == request.auth.uid
        && notificationId.matches('^' + request.auth.uid + '_.*')
        && request.resource.data.type in ['class-reminder', 'class-cancelled']
        && request.resource.data.read == false
        && request.resource.data.keys().hasOnly(['userId', 'type', 'title', 'body', 'scheduleId', 'classDate', 'read', 'delivery', 'createdAt']);
      allow update: if isActive() && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if false;
    }

    // Rosters: who is enrolled (names and ID numbers). Only Admins and the class's own Instructor can read them,
    // so students never see classmates' details. Students find their own classes through schedules.studentIds.
    match /rosters/{scheduleId} {
      allow read: if isAdmin() || (isInstructor() && (resource == null || resource.data.instructorId == request.auth.uid));
      allow write: if isAdmin();
    }

    // Activity log: any active user may add an entry about their OWN action; only Admins read; nobody edits or deletes.
    match /activityLog/{logId} {
      allow read: if isAdmin();
      allow create: if isActive()
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.actorRole == role()
        && request.resource.data.keys().hasOnly(['actorId', 'actorName', 'actorRole', 'action', 'summary', 'targetType', 'targetId', 'createdAt'])
        && request.resource.data.summary is string && request.resource.data.summary.size() <= 300
        && request.resource.data.action is string && request.resource.data.action.size() <= 40;
      allow update, delete: if false;
    }

    // Everything else is denied until its phase adds explicit rules.
    match /{document=**} { allow read, write: if false; }
  }
}
