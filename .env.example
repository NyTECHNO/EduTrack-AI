# Firebase web app config (Firebase console > Project settings > Your apps).
# These are public identifiers, not secrets, but keep them out of source control anyway.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Region your Cloud Functions are deployed to (must match functions/src/index.js)
VITE_FUNCTIONS_REGION=asia-southeast1
# Used by Phase 10 (push notifications): Firebase console > Cloud Messaging > Web Push certificates
VITE_FIREBASE_VAPID_KEY=
